# ==============================================================================
# SENGRA — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local (for Next.js development) and fill in your values.
# NEVER commit .env.local or any file containing live credentials to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FalkorDB Cloud (Managed Instance over TLS)
# ------------------------------------------------------------------------------
# Obtain these credentials from your FalkorDB Cloud console:
# https://app.falkordb.cloud/
FALKORDB_HOST="your-falkordb-instance.cloud.falkordb.com"
FALKORDB_PORT=6379
FALKORDB_USERNAME="default"
FALKORDB_PASSWORD="your-falkordb-password"
FALKORDB_TLS=true

# Prefix to namespace environments on a single FalkorDB instance:
# Examples: 'dev_', 'test_', 'prod_'
FALKORDB_GRAPH_PREFIX="dev_"

# ------------------------------------------------------------------------------
# 2. Anthropic API (Claude Model Access via Vercel AI SDK)
# ------------------------------------------------------------------------------
# API key from Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-api03-placeholder-key"

# ------------------------------------------------------------------------------
# 3. Model Context Protocol (MCP Route Protection)
# ------------------------------------------------------------------------------
# Shared secret protecting the internal /api/mcp endpoint from unauthorized calls
MCP_SHARED_SECRET="generate-a-secure-random-token-here"
